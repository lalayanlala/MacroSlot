<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.1.0</Version>
    <Author>MacroSlot contributors</Author>
    <Name>MacroSlot</Name>
    <AssemblyName>MacroSlot</AssemblyName>
    <RootNamespace>MacroSlot</RootNamespace>
    <Punchline>指定したホットバースロットを個人・共通マクロに差し替えます。</Punchline>
    <Description>/mslot コマンドで、指定した1スロットだけを個人または共通マクロへ安全に差し替える小型プラグインです。</Description>
    <Tags>hotbar;macro;utility</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>

